{
  "name": "pi-desktop",
  "version": "1.2.3",
  "description": "A minimal desktop frontend for your installed Pi",
  "main": "./out/main/index.js",
  "author": "YM",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-terminal.mjs && electron-vite dev",
    "build": "node scripts/prepare-terminal.mjs && electron-vite build && node --check out/main/index.js",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:terminal-native": "node scripts/prepare-terminal.mjs && node tests/terminal-native-smoke.mjs",
    "package": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "image-size": "^2.1.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.469.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shell-env": "^4.0.3",
    "shiki": "^1.24.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^25.0.1",
    "pdfjs-dist": "^6.5.438",
    "typescript": "5.7",
    "vite": "^8.1.3",
    "vitest": "^4.1.11"
  }
}
